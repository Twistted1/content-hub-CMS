# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.

# Supabase project credentials
# Found in: Supabase Dashboard → Project Settings → API
VITE_SUPABASE_PROJECT_ID="your-supabase-project-id"
VITE_SUPABASE_PUBLISHABLE_KEY="your-supabase-anon-key"
VITE_SUPABASE_URL="https://your-project-id.supabase.co"

# Sentry error monitoring
# Found in: sentry.io → Project → Settings → Client Keys (DSN)
# Leave empty to disable Sentry (no-op when absent)
VITE_SENTRY_DSN=""

# Production site URL (used by Stripe edge functions for redirect URLs)
SITE_URL="https://your-production-domain.com"

# Supabase Edge Function secrets are set directly in the Supabase dashboard:
# Project → Edge Functions → Secrets
#
# Billing:
#   STRIPE_SECRET_KEY       - Stripe secret key (sk_live_... or sk_test_...)
#   STRIPE_WEBHOOK_SECRET   - Stripe webhook signing secret (whsec_...)
#   SITE_URL                - Production URL, for Stripe redirect callbacks
#
# AI:
#   OPENAI_API_KEY          - OpenAI key (Novee assistant + content generation)
#
# Direct publishing (OAuth):
#   TWITTER_CLIENT_ID       - X/Twitter OAuth 2.0 client ID
#   TWITTER_CLIENT_SECRET   - X/Twitter OAuth 2.0 client secret
#   LINKEDIN_CLIENT_ID      - LinkedIn OAuth client ID
#   LINKEDIN_CLIENT_SECRET  - LinkedIn OAuth client secret
#
# Webhook authenticity (recommended; required before pointing a webhook at a
# receiver you care about):
#   WEBHOOK_SIGNING_SECRET  - HMAC key for outbound webhook signatures. Every
#                             delivery then carries `X-Novus-Signature:
#                             sha256=<hex>` over the raw body, so the receiver can
#                             refuse anything that did not come from this CMS.
#                             Unset, deliveries are sent UNSIGNED and the
#                             delivery result records signed:false. See
#                             tools/webhook-receiver/ for a working receiver that
#                             verifies it.
#
# AI (secondary provider):
#   GEMINI_API_KEY          - Google Gemini key. REQUIRED by the `generate-strategy`
#                             edge function, which the Automation page reaches.
#                             Without it that feature fails.
#
# Supplied by the Supabase runtime; do NOT set these by hand:
#   SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY
#
# The cron secret is stored in Vault, not here:
#   SELECT vault.create_secret('<long random string>', 'cron_secret');
#
# Demo login — OPTIONAL, preview only, leave unset in production:
#   DEMO_LOGIN_ENABLED      - Must be exactly "true" to enable the endpoint
#   DEMO_LOGIN_EMAIL        - Demo account email (default test@contenthub.io)
#   DEMO_ALLOWED_ORIGINS    - Comma-separated Origin allowlist
#
# Leaked-password protection: enforced in the client
# (src/utils/pwnedPassword.ts + src/utils/passwordPolicy.ts) against the free
# HaveIBeenPwned Pwned Passwords range API, with no key and no configuration
# required. This is the free substitute for Supabase's Pro-only "Leaked
# Password Protection" toggle. It is advisory: it runs before signUp and
# before updateUser, refusing breached passwords with a user-facing message.
# Supabase's own `before_user_created` Auth Hook cannot replace it — that
# hook receives the `auth.users` row (bcrypt hash only), never the plaintext
# password, so it has nothing to compare against HIBP. For true server-side
# enforcement, enable the Pro toggle or move signup behind an owned backend
# holding a service role key.
