# E2E (Playwright) test environment — points the app at a DISPOSABLE
# Supabase test project, never at production. Copy to .env.e2e locally,
# or set these as GitHub Actions repo secrets for CI (see .github/workflows/e2e.yml).
# NEVER commit .env.e2e or put a service_role key in .env (the app's real env file).

# Test project's public API URL + publishable/anon key (safe for client-side use).
VITE_SUPABASE_URL="https://your-test-project-id.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-test-project-anon-key"

# Test project's service_role key (Dashboard → Project Settings → API → service_role).
# Used ONLY by e2e/global-setup.ts, server-side, to create/confirm a fixed test user
# via the Admin API — Supabase requires email confirmation and there's no way to
# disable that or fetch this key through the tooling this repo was set up with, so a
# human has to provide it once. NEVER expose this in client code or commit it anywhere.
E2E_SUPABASE_SERVICE_ROLE_KEY=""

# Fixed credentials the E2E suite signs in as. Defaults below are fine for a
# disposable test project; override if you want something else.
E2E_TEST_EMAIL="e2e-test@contenthub.test"
E2E_TEST_PASSWORD="E2E-test-password-1"
